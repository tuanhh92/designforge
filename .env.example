# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://designforge:designforge@localhost:5432/designforge

# ── Storage (local filesystem for the MVP; S3/Supabase later) ───────────────
STORAGE_DIR=./var/storage

# ── API ─────────────────────────────────────────────────────────────────────
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ── AI ──────────────────────────────────────────────────────────────────────
# AI_PROVIDER = openai | anthropic | mock   (mock needs no key: deterministic demo analysis)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Geometry ────────────────────────────────────────────────────────────────
# GEOMETRY_ENGINE = gltf | sketchup_mcp
#   gltf          → always available; produces model.glb for the web viewer
#   sketchup_mcp  → also drives SketchUp through the DesignForge MCP server (produces .skp, scenes)
GEOMETRY_ENGINE=gltf
# How the worker launches the SketchUp MCP server (stdio). Default = the server in this repo.
SKETCHUP_MCP_COMMAND=python
SKETCHUP_MCP_ARGS=extensions/sketchup-mcp-server/server.py
# Port, token and job folder are read from ~/.designforge/bridge.json (created by `make bridge-setup`),
# the same file the SketchUp extension reads. Set these only to override that file.
# DF_BRIDGE_PORT=9877
# DF_BRIDGE_TOKEN=
# DF_JOB_ROOT=/absolute/path/to/jobs

# ── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
